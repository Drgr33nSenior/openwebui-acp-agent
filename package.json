{
  "name": "openwebui-acp-agent",
  "version": "0.3.0",
  "description": "Unofficial local Open WebUI coding agent for ACP clients",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drgr33nSenior/openwebui-acp-agent.git"
  },
  "homepage": "https://github.com/Drgr33nSenior/openwebui-acp-agent#readme",
  "bugs": "https://github.com/Drgr33nSenior/openwebui-acp-agent/issues",
  "author": "Drgr33nSenior",
  "license": "MIT",
  "type": "module",
  "bin": {
    "openwebui-acp-agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "docs",
    "registry",
    "NOTICE",
    "browser/*.mjs",
    "browser/*.json",
    "browser/Dockerfile",
    "browser/.dockerignore",
    "browser/compose.yaml",
    "browser/test/*.test.mjs"
  ],
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.6.0",
    "@anthropic-ai/sandbox-runtime": "0.0.83",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "ajv": "8.20.0",
    "ignore": "7.0.5",
    "zod": "4.6.7"
  },
  "bundleDependencies": [
    "@anthropic-ai/sandbox-runtime"
  ],
  "devDependencies": {
    "@types/node": "24.10.1",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "@anthropic-ai/sandbox-runtime@0.0.83": {
      "zod": "$zod"
    }
  }
}
